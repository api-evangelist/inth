{
  "opencollection": "1.0.0",
  "info": {
    "name": "c15t Backend Consent Status API",
    "version": "2.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check and API status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-instance.c15t.dev/status"
          },
          "docs": "Health check and API status"
        },
        {
          "info": {
            "name": "OpenAPI specification for this backend (generated at runtime)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://your-instance.c15t.dev/spec.json"
          },
          "docs": "OpenAPI specification for this backend (generated at runtime)"
        }
      ]
    }
  ],
  "bundled": true
}